import React, { useEffect, useState } from 'react';
import ReactApexChart from 'react-apexcharts';

const ApexChart = () => {
  const [state, setState] = React.useState({
    
      series: [{
          name: "IBM Stock Price",   
          data: [],
      }],
      options: {
        chart: {
          height: 350,
          type: 'line',
        },
        title: {
          text: 'IBM Real-Time Stock Price', 
        }, 
        xaxis: {
          categories: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep'],
        }

      },
    
    
  });

const [fetchData, setFetchData] = useState([]);
  useEffect(() => {
    const fetchChartData = async () => {
    const res = await fetch('http://localhost:5000/api/fetch-stocks');
    // console.log(res.body)
    const data = await res.json(); 
    // console.log(data)
    
 
    const newData = [];
    for (let i = 0; i < data.length; i++) {
      // console.log(data[i].date, data[i].close)
      newData.push({
        x: new Date(data[i].date).toISOString().split('T')[0].split('-').reverse().join('-'),
        y: data[i].close.toFixed(2)
      })
    }
    // console.log("newData", newData);
    setFetchData(newData);
  };

  fetchChartData();
}, []);

return (
  <div>
    <div id="chart">
      <ReactApexChart options={state.options} series={state.series} type="line" height={350} />
    </div>
    <div id="html-dist" style={{ marginTop: '20px', border: '1px solid black', padding: '10px' }}>
      <h3 style={{ textAlign: 'center' }}>Stock Data</h3>
      <table border="1" style={{ width: '100%', textAlign: 'center', borderCollapse: 'collapse' }}>
        <thead>
          <tr>
            <th style={{ padding: '8px', border: '1px solid black' }}>Date</th>
            <th style={{ padding: '8px', border: '1px solid black' }}>Stock Price</th>
          </tr>
        </thead>
        <tbody>
          {fetchData.length > 0 ? (
            fetchData.map((item, index) => (
              <tr key={index}>
                <td style={{ padding: '8px', border: '1px solid black' }}>{item.x}</td>
                <td style={{ padding: '8px', border: '1px solid black' }}>{item.y}</td>
              </tr>
            ))
          ) : null}
        </tbody>
      </table>
    </div>
  </div>
  );
};
export default ApexChart;





