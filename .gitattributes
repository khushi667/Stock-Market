# Set default behavior to automatically normalize line endings.
* text=auto

# Explicitly set text files to use LF (Unix-style) line endings.
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf

# Set text files for Windows to use CRLF (Windows-style) line endings.
# (Optional, use if needed for specific files like batch scripts)
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files should never be converted (e.g., images, PDFs)
*.jpg binary
*.png binary
*.pdf binary
